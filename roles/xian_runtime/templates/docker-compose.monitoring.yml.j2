x-logging: &x-logging
  driver: local
  options:
    max-size: "{{ xian_docker_log_max_file_mb | int }}m"
    max-file: "{{ xian_docker_log_max_files | int }}"
    mode: blocking

networks:
  xian-net:
    internal: false

volumes:
  grafana-data:

services:
  prometheus:
    logging: *x-logging
    image: {{ xian_prometheus_image | to_json }}
    restart: unless-stopped
    hostname: {{ xian_project_name }}-prometheus
    # Recreate Prometheus when its mounted content changes.
    labels:
      io.xian.monitoring.bundle-sha256: {{ (xian_monitoring_bundle_sha256 | lower) | to_json }}
      io.xian.monitoring.config-sha1: {{ xian_rendered_prometheus_config.checksum | to_json }}
    command:
      [
        "--config.file=/etc/prometheus/prometheus.yml",
        "--storage.tsdb.path=/prometheus"
      ]
    volumes:
      - {{ (xian_monitoring_dir ~ '/prometheus:/etc/prometheus:ro') | to_json }}
    networks:
      - xian-net
    ports:
      - target: 9090
        published: {{ (xian_prometheus_port | string) | to_json }}
        host_ip: {{ (xian_prometheus_bind_host | string | regex_replace('^\\[(.*)\\]$', '\\1')) | to_json }}
        protocol: tcp

  # Host metrics for the disk alerts. Reachable only on the compose network
  # (Prometheus scrapes node-exporter:9100); no port is published. The host
  # root is mounted read-only without mount propagation.
  node-exporter:
    logging: *x-logging
    image: {{ xian_node_exporter_image | to_json }}
    restart: unless-stopped
    hostname: {{ xian_project_name }}-node-exporter
    command: ["--path.rootfs=/host"]
    volumes:
      - /:/host:ro
    networks:
      - xian-net

  grafana:
    logging: *x-logging
    image: {{ xian_grafana_image | to_json }}
    restart: unless-stopped
    hostname: {{ xian_project_name }}-grafana
    labels:
      io.xian.monitoring.bundle-sha256: {{ (xian_monitoring_bundle_sha256 | lower) | to_json }}
    depends_on:
      prometheus:
        condition: service_started
    environment:
      GF_AUTH_ANONYMOUS_ENABLED: "true"
      GF_AUTH_ANONYMOUS_ORG_ROLE: "Viewer"
      GF_AUTH_DISABLE_LOGIN_FORM: "true"
      GF_SERVER_HTTP_PORT: "3000"
    volumes:
      - grafana-data:/var/lib/grafana
      - {{ (xian_monitoring_dir ~ '/grafana/provisioning:/etc/grafana/provisioning:ro') | to_json }}
      - {{ (xian_monitoring_dir ~ '/grafana/dashboards:/var/lib/grafana/dashboards:ro') | to_json }}
    networks:
      - xian-net
    ports:
      - target: 3000
        published: {{ (xian_grafana_port | string) | to_json }}
        host_ip: {{ (xian_grafana_bind_host | string | regex_replace('^\\[(.*)\\]$', '\\1')) | to_json }}
        protocol: tcp
