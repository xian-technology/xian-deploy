global:
  scrape_interval: 5s
  evaluation_interval: 5s

{% if xian_monitoring_alert_variant == "shared_network" %}
rule_files:
  - /etc/prometheus/rules/shared-network.yml
{% if xian_block_policy_mode != "on_demand" %}
  - /etc/prometheus/rules/block-cadence.yml
{% endif %}
{% endif %}
{% if xian_alertmanager_targets | length > 0 %}

alerting:
  alertmanagers:
    - static_configs:
        - targets: {{ xian_alertmanager_targets | to_json }}
{% endif %}

scrape_configs:
  - job_name: xian_abci
    static_configs:
      - targets:
          - abci:{{ xian_app_metrics_container_port }}

  - job_name: xian_cometbft
    static_configs:
      - targets:
          - abci:26660

  - job_name: xian_node
    static_configs:
      - targets:
          - node-exporter:9100
