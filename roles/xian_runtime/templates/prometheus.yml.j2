global:
  scrape_interval: 5s
  evaluation_interval: 5s

rule_files:
  - /etc/prometheus/rules.yml
{% if xian_alertmanager_targets | length > 0 %}

alerting:
  alertmanagers:
    - static_configs:
        - targets: {{ xian_alertmanager_targets | to_json }}
{% endif %}

scrape_configs:
  - job_name: xian_abci
    static_configs:
      - targets:
{% if xian_deploy_topology == "integrated" %}
          - abci:{{ xian_app_metrics_container_port }}
{% else %}
          - abci-app:{{ xian_app_metrics_container_port }}
{% endif %}

  - job_name: xian_cometbft
    static_configs:
      - targets:
{% if xian_deploy_topology == "integrated" %}
          - abci:26660
{% else %}
          - cometbft:26660
{% endif %}

  - job_name: xian_node
    static_configs:
      - targets:
          - node-exporter:9100
